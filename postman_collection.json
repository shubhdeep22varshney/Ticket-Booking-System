{
  "info": {
    "name": "Distributed Ticket Booking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Event",
      "request": {
        "auth": {"type": "basic", "basic": [{"key": "username", "value": "admin", "type": "string"}, {"key": "password", "value": "admin123", "type": "string"}]},
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Avengers Movie Show\",\n  \"location\": \"Screen 1, Delhi\",\n  \"eventDateTime\": \"2026-05-10T18:30:00\",\n  \"totalSeats\": 10,\n  \"ticketPrice\": 250\n}"
        },
        "url": {"raw": "http://localhost:8080/api/admin/events", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "admin", "events"]}
      }
    },
    {
      "name": "Get All Events",
      "request": {
        "auth": {"type": "basic", "basic": [{"key": "username", "value": "user", "type": "string"}, {"key": "password", "value": "user123", "type": "string"}]},
        "method": "GET",
        "url": {"raw": "http://localhost:8080/api/events", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "events"]}
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "auth": {"type": "basic", "basic": [{"key": "username", "value": "user", "type": "string"}, {"key": "password", "value": "user123", "type": "string"}]},
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 2,\n  \"eventId\": 1,\n  \"seatIds\": [1, 2]\n}"
        },
        "url": {"raw": "http://localhost:8080/api/bookings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "bookings"]}
      }
    },
    {
      "name": "Get Bookings by User",
      "request": {
        "auth": {"type": "basic", "basic": [{"key": "username", "value": "user", "type": "string"}, {"key": "password", "value": "user123", "type": "string"}]},
        "method": "GET",
        "url": {"raw": "http://localhost:8080/api/bookings/user/2", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "bookings", "user", "2"]}
      }
    }
  ]
}
